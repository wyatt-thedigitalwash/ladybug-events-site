# Resend, for form notification emails. Key lives in the Vercel dashboard.
RESEND_API_KEY=

# Sender address. REQUIRED in production.
# Must be on a domain verified in Resend. kdbugs.com is not verified and is not
# going to be, so mail is sent from thedigitalwash.com instead. Resend verifies
# the SENDING domain, not the recipient, so this delivers to kdbugs.com fine.
# Replies go to the visitor, not here: replyTo is set on every send.
# Leaving this blank falls back to onboarding@resend.dev, which only delivers
# to the Resend account's own address. Fine locally, wrong in production.
LADYBUG_FROM_EMAIL="The Ladybug Venue <noreply@thedigitalwash.com>"

# Optional. Defaults to info@kdbugs.com (src/lib/site.ts).
# Comma-separated for more than one. Set it on preview deploys so test
# submissions do not reach the owners.
LADYBUG_NOTIFY_EMAIL=

# Neon Postgres. Injected automatically by the Vercel integration:
# Vercel dashboard -> Storage -> Create Database -> Neon Postgres.
# Leave the integration's "Custom Prefix" field EMPTY. A prefix renames this to
# something like STORAGE_URL, which the app does not read.
DATABASE_URL=

# Password for /admin, where submissions are listed and exported.
LADYBUG_ADMIN_PASSWORD=
